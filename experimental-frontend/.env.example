# Optional default backend address packaged in the Android frontend.
# Device-specific settings in Menu -> Connection override this value.
# localhost works with adb reverse tcp:8077 tcp:8077; emulator can use 10.0.2.2.
VITE_BACKEND_BASE_URL=http://localhost:8077

# Optional public Photon service. Never place private credentials in VITE_*.
VITE_PHOTON_BASE_URL=https://photon.komoot.io
