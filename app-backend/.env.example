# Copy this file to app-backend/.env and enter your private credentials there.
# The backend loads it on startup; existing process variables take precedence.
PORT=8077
IMIQ_ROUTING_BASE_URL=https://imiq-app.et.uni-magdeburg.de/api/routing
IMIQ_GRAPHHOPPER_BASE_URL=https://imiq-app.et.uni-magdeburg.de/api/graphhopper
IMIQ_ORION_BASE_URL=https://imiq-public.et.uni-magdeburg.de/api/orion
# Optional private Orion deployment:
# IMIQ_ORION_API_KEY=YOUR_KEY_HERE
# Optional LLM provider; absent credentials leave narration disabled/fallback.
# IMIQ_XAI_LLM_API_KEY=YOUR_KEY_HERE
# IMIQ_XAI_LLM_MODEL=YOUR_MODEL_HERE

# Groq voice for saved journey choices. Restart the backend after editing.
CRICKET_CHOICE_LLM_ENABLED=1
GROQ_API_KEY=

# Local OTP transit service and realtime feed monitor. Restart after editing.
CRICKET_OTP_BASE_URL=http://127.0.0.1:8091
CRICKET_OTP_STATUS_URL=http://127.0.0.1:8092/status
